---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const isDev = import.meta.env.DEV;
const all = await getCollection("projects", ({ data }) => isDev || !data.draft);
const shopHumble = all
  .filter((p) => p.data.category === "shop-humble")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const securityIt = all
  .filter((p) => p.data.category === "security-it")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects" description="Shop Humble woodworking builds and security/IT projects.">
  <h1 class="font-serif text-3xl mb-2">Projects</h1>
  <p class="text-shopfloor/80 max-w-xl mb-10">
    Two sides of the same instinct — building things that hold up, whether
    that's out of walnut or out of infrastructure.
  </p>

  <section class="mb-14">
    <h2 class="meta text-xs uppercase text-copper mb-4">Shop Humble</h2>
    {
      shopHumble.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {shopHumble.map((project) => (
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              summary={project.data.summary}
              category={project.data.category}
              tags={project.data.tags}
              coverImage={project.data.coverImage}
              draft={project.data.draft}
            />
          ))}
        </div>
      ) : (
        <div class="border-2 border-dashed border-copper/40 p-8 text-center">
          <p class="meta text-xs uppercase text-copper mb-1">Under construction</p>
          <p class="text-sm text-shopfloor/60">Real Shop Humble builds are coming soon.</p>
        </div>
      )
    }
  </section>

  <section>
    <h2 class="meta text-xs uppercase text-slate mb-4">Security &amp; IT</h2>
    {
      securityIt.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {securityIt.map((project) => (
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              summary={project.data.summary}
              category={project.data.category}
              tags={project.data.tags}
              coverImage={project.data.coverImage}
              draft={project.data.draft}
            />
          ))}
        </div>
      ) : (
        <div class="border-2 border-dashed border-slate/40 p-8 text-center">
          <p class="meta text-xs uppercase text-slate mb-1">Under construction</p>
          <p class="text-sm text-shopfloor/60">Security &amp; IT project write-ups are coming soon.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
