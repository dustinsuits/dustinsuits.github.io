---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "Email", href: "mailto:dustinsuits@gmail.com" },
  { label: "GitHub", href: "https://github.com/dustinsuits" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/dustinsuits/" },
  { label: "Shop Humble - Etsy", href: "https://shophumble.etsy.com" },
  { label: "Shop Humble - Instagram", href: "https://www.instagram.com/shophumble" },
];
---

<BaseLayout title="Contact" description="Find Dustin Suits elsewhere on the web.">
  <h1 class="font-serif text-3xl mb-6">Find me elsewhere</h1>
  <ul class="space-y-3">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="text-lg hover:text-copper">
            {link.label} &rarr;
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
