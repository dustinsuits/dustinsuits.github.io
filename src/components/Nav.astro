---
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/notes/", label: "Notes" },
  { href: "/now/", label: "Now" },
  { href: "/experience/", label: "Experience" },
  { href: "/contact/", label: "Contact" },
];

const current = Astro.url.pathname;
---

<header class="border-b border-walnut/20">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href="/" class="font-serif text-lg font-medium mr-auto">Dustin Suits</a>
    {
      links.slice(1).map((link) => {
        const active = current === link.href;
        return (
          <a
            href={link.href}
            class:list={[
              "meta text-sm uppercase",
              active ? "text-copper" : "text-shopfloor/70 hover:text-copper",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</header>
